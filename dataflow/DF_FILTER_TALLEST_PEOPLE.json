{
	"name": "DF_FILTER_TALLEST_PEOPLE",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_FLOW_TALLEST_PEOPLE",
						"type": "DatasetReference"
					},
					"name": "SourceCsvFile"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_FLOW_TARGET_TALLEST_PEOPLE",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "filterdata"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SourceCsvFile",
				"SourceCsvFile filter(toString(byName('gender')) == 'Male') ~> filterdata",
				"filterdata sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['tallest_people_filtered'],",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink"
			]
		}
	}
}